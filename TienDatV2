--  MODULE 12 — AntiDetection
-- ══════════════════════════════════════════════════════════════════════════
local AntiDetection = {}
local AD_Config = {
    ClickDelay = 0.2,
    RandomYTween = false,
    RandomYRange = { min = -3, max = 6 },
    RandomPosition = false,
    RandomPosRadius = 12,
    HitAndRun = true,
    HitAndRunChance = 0.35,
    PredictMove = true,
    PredictMultiplier = 0.15,
    Skills = {
        Melee = { Enabled = true, Z = { true, 0.100, 0.165 }, X = { true, 0.300, 0.246 }, C = { true, 0.500, 0.125 } },
        BloxFruit = { Enabled = false, Z = { true, 1.325, 0.900 }, X = { true, 0.600, 0.235 }, C = { true, 0.200, 0.435 }, V = { true, 0.300, 0.195 }, F = { true, 0.000, 0.600 } },
        Sword = { Enabled = true, Z = { true, 0.500, 0.200 }, X = { true, 0.300, 0.400 } },
    },
    MaxComboLength = 4,
    MinComboLength = 2,
    ComboBreakChance = 0.2,
    ComboRestMin = 1.0,
    ComboRestMax = 3.0,
    MaxInputHz = 15,
}
local AD_State = {
    VIM = game:GetService("VirtualInputManager"),
    Camera = workspace.CurrentCamera,
    LastInputTime = 0,
    InputCount = 0,
    LastMousePos = Vector2.new(0, 0),
    IsResting = false,
    PredictCache = {},
}

local function AD_hasVIM()
    return AD_State.VIM ~= nil and type(AD_State.VIM.SendMouseButtonEvent) == "function"
end

local function AD_fallbackClick()
    local char = LP.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
end

local function AD_canInput()
    local now = tick()
    if now - AD_State.LastInputTime < (1 / AD_Config.MaxInputHz) then return false end
    AD_State.LastInputTime = now
    return true
end

local function AD_click(x, y, down)
    if not AD_hasVIM() then return AD_fallbackClick() end
    return pcall(function()
        AD_State.VIM:SendMouseButtonEvent(x, y, 0, down, game, 0)
    end)
end

local function AD_key(keyCode, down)
    if not AD_hasVIM() then return end
    pcall(function()
        AD_State.VIM:SendKeyEvent(down, keyCode, false, game)
    end)
end

local function AD_gaussian(min, max)
    local mean = (min + max) / 2
    local stddev = (max - min) / 4
    local u1, u2 = math.random(), math.random()
    local z = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
    return math.clamp(mean + z * stddev, min, max)
end

local function AD_getPredictedPos(hrp)
    if not hrp then return nil end
    local now = tick()
    local cache = AD_State.PredictCache[hrp]
    if cache and now - cache.time < 0.1 then return cache.pos end
    local vel = hrp.AssemblyLinearVelocity
    local pos = hrp.Position + vel * AD_Config.PredictMultiplier
    AD_State.PredictCache[hrp] = { pos = pos, time = now }
    return pos
end

local function AD_applyRandomYTween(pos)
    if not AD_Config.RandomYTween then return pos end
    local y = math.random(AD_Config.RandomYRange.min, AD_Config.RandomYRange.max)
    return pos + Vector3.new(0, y, 0)
end

local function AD_applyRandomPosition(pos)
    if not AD_Config.RandomPosition then return pos end
    local r = AD_Config.RandomPosRadius
    return pos + Vector3.new(math.random(-r, r), math.random(-r, r) * 0.3, math.random(-r, r))
end

local function AD_executeSkill(skillName, keyChar)
    local table_ = AD_Config.Skills[skillName]
    if not table_ or not table_.Enabled then return false end
    local data = table_[keyChar]
    if not data or not data[1] then return false end
    local delayPress = data[2]
    local delayRelease = data[3]
    local keyCode = Enum.KeyCode[keyChar]
    if not keyCode then return false end
    AD_key(keyCode, true)
    task.wait(delayPress)
    AD_key(keyCode, false)
    task.wait(delayRelease)
    return true
end

local function AD_humanizedClick()
    if not AD_canInput() then return false end
    local vp = AD_State.Camera.ViewportSize
    local cx = vp.X / 2 + math.random(-8, 8)
    local cy = vp.Y / 2 + math.random(-8, 8)
    AD_click(cx, cy, true)
    task.wait(AD_gaussian(0.02, 0.06))
    AD_click(cx, cy, false)
    AD_State.LastMousePos = Vector2.new(cx, cy)
    AD_State.InputCount = AD_State.InputCount + 1
    return true
end

local function AD_humanizedCombo(attackFn, targetHrp)
    if AD_State.IsResting then return end
    local combo = math.random(AD_Config.MinComboLength, AD_Config.MaxComboLength)
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for i = 1, combo do
        if not AD_canInput() then break end
        if AD_Config.PredictMove and targetHrp then
            local atkPos = AD_getPredictedPos(targetHrp)
            if atkPos then
                atkPos = AD_applyRandomYTween(atkPos)
                atkPos = AD_applyRandomPosition(atkPos)
            end
        end
        if attackFn then attackFn() else AD_humanizedClick() end
        task.wait(AD_gaussian(AD_Config.ClickDelay * 0.5, AD_Config.ClickDelay * 1.5))
        if math.random() < AD_Config.ComboBreakChance then
            AD_State.IsResting = true
            local rest = AD_gaussian(AD_Config.ComboRestMin, AD_Config.ComboRestMax)
            task.wait(rest)
            AD_State.IsResting = false
            break
        end
    end
    if AD_Config.HitAndRun and root and targetHrp then
        if math.random() < AD_Config.HitAndRunChance then
            local dir = (root.Position - targetHrp.Position).Unit
            local fleePos = root.Position + dir * 60
            pcall(function()
                root.CFrame = CFrame.new(fleePos)
            end)
        end
    end
end

function AntiDetection.SetClickDelay(v) AD_Config.ClickDelay = math.clamp(tonumber(v) or 0.2, 0.05, 1.0) end
function AntiDetection.SetRandomYTween(on) AD_Config.RandomYTween = on end
function AntiDetection.SetRandomPosition(on) AD_Config.RandomPosition = on end
function AntiDetection.SetHitAndRun(on) AD_Config.HitAndRun = on end
function AntiDetection.SetPredictMove(on) AD_Config.PredictMove = on end
function AntiDetection.Click() return AD_humanizedClick() end
function AntiDetection.Combo(attackFn, targetHrp) AD_humanizedCombo(attackFn, targetHrp) end
function AntiDetection.Skill(skillName, keyChar) return AD_executeSkill(skillName, keyChar) end
function AntiDetection.MouseMove(x, y) end
function AntiDetection.GetState()
    return {
        InputCount = AD_State.InputCount,
        HasVIM = AD_hasVIM(),
        IsResting = AD_State.IsResting,
        Config = {
            ClickDelay = AD_Config.ClickDelay,
            RandomYTween = AD_Config.RandomYTween,
            RandomPosition = AD_Config.RandomPosition,
            HitAndRun = AD_Config.HitAndRun,
            PredictMove = AD_Config.PredictMove,
        },
    }
end

-- Wire into API
API.HumanizedAttack = function()
    return AntiDetection.Click()
end
API.HumanizedCombo = function(attackFn)
    AntiDetection.Combo(attackFn)
end

