--  MODULE 6 — FruitSniper
-- ══════════════════════════════════════════════════════════════════════════
local FruitSniper = {}
local Sniper_Config = { MaxRange = 3000, ScanTTL = 0.8, TweenMax = 1.2, PickupWait = 0.4 }
local Sniper_State = { Enabled = false, Seen = {}, Count = 0, CacheAt = 0, List = {} }

local function Sniper_getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Sniper_scan()
    local now = tick()
    if now - Sniper_State.CacheAt < Sniper_Config.ScanTTL then return Sniper_State.List end
    Sniper_State.List = API.ScanFruits(Sniper_Config.MaxRange)
    Sniper_State.CacheAt = now
    return Sniper_State.List
end

local function Sniper_pickup(root, entry)
    local dist = (entry.handle.Position - root.Position).Magnitude
    if dist < 3 then return end
    local dur = math.clamp(dist / 1500, 0.1, Sniper_Config.TweenMax)
    local tw = Services.TweenService:Create(
        root, TweenInfo.new(dur, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(entry.handle.Position + Vector3.new(0, 3, 0)) }
    )
    tw:Play()
    tw.Completed:Wait()
    local pp = entry.obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp and fireproximityprompt then
        pcall(fireproximityprompt, pp)
    end
    task.wait(Sniper_Config.PickupWait)
end

local function Sniper_loop()
    while Sniper_State.Enabled and Core.State.Status == "RUNNING" do
        pcall(function()
            local root = Sniper_getRoot()
            if not root then task.wait(1); return end
            for _, entry in ipairs(Sniper_scan()) do
                if not Sniper_State.Enabled then break end
                if not Sniper_State.Seen[entry.obj] then
                    Sniper_State.Seen[entry.obj] = true
                    Core.Log("FruitSniper", "INFO", "fruit found: "..entry.name)
                    Sniper_pickup(root, entry)
                    Sniper_State.Count = Sniper_State.Count + 1
                    Core.Emit("FruitSniper:Picked", { name = entry.name })
                end
            end
        end)
        task.wait(Sniper_Config.ScanTTL)
    end
end

function FruitSniper.Toggle(on)
    if on == Sniper_State.Enabled then return end
    Sniper_State.Enabled = on
    if on then
        Core.StartModule("FruitSniper", Sniper_loop)
        Core.Log("FruitSniper", "INFO", "BẬT")
    else
        Core.StopModule("FruitSniper")
        Core.Log("FruitSniper", "INFO", "TẮT — picked="..Sniper_State.Count)
    end
end

function FruitSniper.SetRange(v)
    local n = tonumber(v)
    if n then Sniper_Config.MaxRange = math.clamp(n, 500, 5000) end
end

function FruitSniper.GetState()
    return { Enabled = Sniper_State.Enabled, Count = Sniper_State.Count }
end

