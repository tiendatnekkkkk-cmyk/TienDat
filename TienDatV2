--  MODULE 1 — FastAttack
-- ══════════════════════════════════════════════════════════════════════════
local FastAttack = {}
local FA_Config = {
    HitboxMagnitude = 150,
    AttackIncrement = 4,
    ThrottleMs      = 16,
    FallbackCooldown= 0.05,
    MaxHookAttempts = 10,
}
local FA_State = { Enabled = false, Hooked = false, AttackCount = 0, LastAttack = 0, Upvalues = nil, HookConn = nil }

local function FA_scanForActiveController()
    local ok, reg = pcall(getreg)
    if not ok then return nil end
    local ps = LP:FindFirstChild("PlayerScripts")
    local cf = ps and ps:FindFirstChild("CombatFramework")
    if not cf then return nil end
    local attempts = 0
    for _, v in ipairs(reg) do
        if attempts >= FA_Config.MaxHookAttempts then break end
        if typeof(v) == "function" then
            local ok2, env = pcall(getfenv, v)
            if ok2 and env and env.script == cf then
                attempts = attempts + 1
                local ok3, ups = pcall(debug.getupvalues, v)
                if ok3 and ups then
                    for _, uv in ipairs(ups) do
                        if typeof(uv) == "table" and uv.activeController then
                            Core.Log("FastAttack", "INFO", "hook found after "..attempts.." scans")
                            return uv
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function FA_applyStats(ac)
    if not ac then return end
    if ac.attacking == nil and ac.timeToNextAttack == nil then return end
    ac.timeToNextAttack = -math.huge
    ac.attacking        = false
    ac.increment        = FA_Config.AttackIncrement
    ac.blocking         = false
    ac.hitboxMagnitude  = FA_Config.HitboxMagnitude
    if ac.humanoid then ac.humanoid.AutoRotate = true end
end

local function FA_fallbackAttack()
    local now = tick()
    if now - FA_State.LastAttack < FA_Config.FallbackCooldown then return end
    FA_State.LastAttack = now
    local char = LP.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    pcall(function()
        Services.VirtualUser:CaptureController()
        Services.VirtualUser:Button1Down(Vector2.zero)
        Services.VirtualUser:Button1Up(Vector2.zero)
    end)
    FA_State.AttackCount = FA_State.AttackCount + 1
end

local function FA_onRenderStep()
    if not FA_State.Enabled then return end
    if Core.State.Status ~= "RUNNING" then return end
    local now = tick()
    if (now - (FA_State.LastFrame or 0)) * 1000 < FA_Config.ThrottleMs then return end
    FA_State.LastFrame = now
    local char = LP.Character
    if not char then return end
    if FA_State.Upvalues and FA_State.Upvalues.activeController then
        pcall(FA_applyStats, FA_State.Upvalues.activeController)
    else
        FA_fallbackAttack()
    end
end

local function FA_ensureHooked()
    if FA_State.Hooked and FA_State.HookConn and FA_State.HookConn.Connected then return end
    if not FA_State.Upvalues then
        FA_State.Upvalues = FA_scanForActiveController()
        if not FA_State.Upvalues then
            if not FA_State.HookConn then
                FA_State.HookConn = Services.RunService.RenderStepped:Connect(FA_onRenderStep)
            end
            FA_State.Hooked = true
            return
        end
    end
    if not FA_State.HookConn then
        FA_State.HookConn = Services.RunService.RenderStepped:Connect(FA_onRenderStep)
    end
    FA_State.Hooked = true
end

function FastAttack.Toggle(on)
    if on == FA_State.Enabled then return end
    FA_State.Enabled = on
    if on then
        FA_ensureHooked()
        Core.Log("FastAttack", "INFO", "BẬT")
    else
        if FA_State.HookConn then
            pcall(function() FA_State.HookConn:Disconnect() end)
            FA_State.HookConn = nil
        end
        FA_State.Hooked = false
        Core.Log("FastAttack", "INFO", "TẮT")
    end
end

function FastAttack.GetState()
    return { Enabled = FA_State.Enabled, Hooked = FA_State.Hooked, AttackCount = FA_State.AttackCount }
end

