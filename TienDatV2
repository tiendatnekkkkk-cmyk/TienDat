    FishmanQuest   = { npc = Vector3.new(2010, -109, 700),   mob = Vector3.new(2050, -109, 750) },
    SkyExp1Quest   = { npc = Vector3.new(-1023, 910, -1315), mob = Vector3.new(-1000, 910, -1300) },
    FountainQuest  = { npc = Vector3.new(2240, 16, -780),    mob = Vector3.new(2280, 16, -800) },
    HauntedQuest1  = { npc = Vector3.new(-9110, 16, 4500),  mob = Vector3.new(-9150, 16, 4550) },
    HauntedQuest2  = { npc = Vector3.new(-9110, 16, 4500),  mob = Vector3.new(-9150, 16, 4550) },
    IceSideQuest   = { npc = Vector3.new(-8400, 206, 1220),  mob = Vector3.new(-8450, 206, 1250) },
    PortQuest      = { npc = Vector3.new(59427, 16, 1825),  mob = Vector3.new(59450, 16, 1850) },
    HydraQuest     = { npc = Vector3.new(61448, 16, -4098), mob = Vector3.new(61480, 16, -4050) },
}
local Quest_State = { Enabled = false, CurrentQuest = nil, LastCheck = 0, QuestCount = 0 }

local function Quest_getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Quest_accept(questName, questNum)
    local db = QuestDB[questName]
    if not db then return false end
    local root = Quest_getRoot()
    if not root then return false end
    local dist = (root.Position - db.npc).Magnitude
    if dist > Quest_Config.QuestRange then
        pcall(function() root.CFrame = CFrame.new(db.npc + Vector3.new(0, 3, 0)) end)
        task.wait(Quest_Config.TPInterval)
    end
    local ok = API.StartQuest(questName, questNum)
    if ok then
        Quest_State.CurrentQuest = questName
        Quest_State.QuestCount = Quest_State.QuestCount + 1
        Core.Log("AutoQuest", "INFO", "accepted: "..questName.." #"..tostring(questNum))
        Core.Emit("AutoQuest:Accepted", { quest = questName, number = questNum })
        return true
    end
    return false
end

local function Quest_abandon()
    API.AbandonQuest()
    Quest_State.CurrentQuest = nil
    Core.Log("AutoQuest", "INFO", "abandoned current quest")
end

local function Quest_loop()
    while Quest_State.Enabled and Core.State.Status == "RUNNING" do
        pcall(function()
            local playerGui = LP:FindFirstChild("PlayerGui")
            local mainGui = playerGui and playerGui:FindFirstChild("Main")
            local questFrame = mainGui and mainGui:FindFirstChild("Quest")
            local hasQuest = questFrame and questFrame.Visible
            if not hasQuest and Quest_State.CurrentQuest == nil then
                local order = {
                    "BanditQuest1", "JungleQuest", "BuggyQuest1",
                    "MarineQuest1", "FishmanQuest", "SkyExp1Quest",
                    "FountainQuest", "HauntedQuest1", "IceSideQuest",
                    "PortQuest", "HydraQuest",
                }
                for _, qName in ipairs(order) do
                    if Quest_accept(qName, 1) then break end
                end
            elseif hasQuest then
                Quest_State.CurrentQuest = "active"
            end
        end)
        task.wait(Quest_Config.CheckInterval)
    end
end

function AutoQuest.Toggle(on)
    if on == Quest_State.Enabled then return end
    Quest_State.Enabled = on
    if on then Core.StartModule("AutoQuest", Quest_loop)
    else Core.StopModule("AutoQuest") end
    Core.Log("AutoQuest", "INFO", on and "BẬT" or "TẮT")
end

function AutoQuest.Abandon() Quest_abandon() end

function AutoQuest.GetState()
    return { Enabled = Quest_State.Enabled, Current = Quest_State.CurrentQuest, Count = Quest_State.QuestCount }
end

