local AutoRaid = {}
local Raid_Config = { CheckInterval = 3.0, RaidMaps = { "Magma", "Flame", "Ice", "Sand", "Dark", "Light" }, RaidIslandRange = 2500 }
local Raid_State = { Enabled = false, RaidCount = 0, CurrentMap = nil }

local function Raid_getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Raid_isActive()
    local pg = LP:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    local hud = main and main:FindFirstChild("TopHUDList")
    local timer = hud and hud:FindFirstChild("RaidTimer")
    return timer and timer.Visible
end

local function Raid_findIsland()
    local root = Raid_getRoot()
    if not root then return nil end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:find("Island") and obj:IsA("BasePart") then
            local dist = (obj.Position - root.Position).Magnitude
            if dist < Raid_Config.RaidIslandRange then return obj end
        end
    end
    return nil
end

local function Raid_start()
    local map = Raid_Config.RaidMaps[math.random(#Raid_Config.RaidMaps)]
    API.SelectRaid(map)
    Raid_State.CurrentMap = map
    Raid_State.RaidCount = Raid_State.RaidCount + 1
    Core.Log("AutoRaid", "INFO", "raid selected: "..map)
    Core.Emit("AutoRaid:Started", { map = map })
end

local function Raid_loop()
    while Raid_State.Enabled and Core.State.Status == "RUNNING" do
        pcall(function()
            if not Raid_isActive() then
                Raid_start()
            else
                local island = Raid_findIsland()
                if island then
                    local root = Raid_getRoot()
                    if root then
                        local dist = (island.Position - root.Position).Magnitude
                        if dist > 50 then
                            pcall(function()
                                root.CFrame = CFrame.new(island.Position + Vector3.new(0, 120, 0))
                            end)
                        end
                    end
                end
            end
        end)
        task.wait(Raid_Config.CheckInterval)
    end
end

function AutoRaid.Toggle(on)
    if on == Raid_State.Enabled then return end
    Raid_State.Enabled = on
    if on then Core.StartModule("AutoRaid", Raid_loop)
    else Core.StopModule("AutoRaid") end
    Core.Log("AutoRaid", "INFO", on and "BẬT" or "TẮT")
end

function AutoRaid.SetMaps(maps)
    if type(maps) == "table" then Raid_Config.RaidMaps = maps end
end

function AutoRaid.GetState()
    return { Enabled = Raid_State.Enabled, RaidCount = Raid_State.RaidCount, CurrentMap = Raid_State.CurrentMap }
end

