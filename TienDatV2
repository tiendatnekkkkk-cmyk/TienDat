--  MODULE 9 — Fishing
-- ══════════════════════════════════════════════════════════════════════════
local Fishing = {}
local Fish_Config = { CastWaitMin = 2.5, CastWaitMax = 3.5, ReelWait = 1.2, RetryDelay = 1.5, RodNameHints = { "Rod", "FishingRod", "FishRod" } }
local Fish_State = { Enabled = false, Casts = 0, Catches = 0 }

local function Fish_getChar()
    local c = LP.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h and h.Health > 0 then return c, h end
end

local function Fish_findRod(char)
    for _, hint in ipairs(Fish_Config.RodNameHints) do
        local t = char:FindFirstChild(hint)
        if t and t:IsA("Tool") then return t end
    end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and (t.Name:find("Rod") or t.Name:find("Fish")) then
            return t
        end
    end
    return nil
end

local function Fish_equipRod(char, hum)
    local bp = LP:FindFirstChild("Backpack")
    if not bp or not hum then return nil end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and (t.Name:find("Rod") or t.Name:find("Fish")) then
            pcall(function() hum:EquipTool(t) end)
            task.wait(0.3)
            return Fish_findRod(char)
        end
    end
    return nil
end

local function Fish_loop()
    while Fish_State.Enabled and Core.State.Status == "RUNNING" do
        local char, hum = Fish_getChar()
        if not char then task.wait(1); return end
        local rod = Fish_findRod(char) or Fish_equipRod(char, hum)
        if not rod then task.wait(2); return end
        local ok = pcall(function() rod:Activate() end)
        if ok then
            Fish_State.Casts = Fish_State.Casts + 1
            task.wait(math.random(Fish_Config.CastWaitMin*10, Fish_Config.CastWaitMax*10)/10)
            local pp = rod:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pp and fireproximityprompt then
                pcall(fireproximityprompt, pp)
                Fish_State.Catches = Fish_State.Catches + 1
            else
                pcall(function() rod:Activate() end)
            end
            task.wait(Fish_Config.ReelWait)
        else
            task.wait(Fish_Config.RetryDelay)
        end
    end
end

function Fishing.Toggle(on)
    if on == Fish_State.Enabled then return end
    Fish_State.Enabled = on
    if on then Core.StartModule("Fishing", Fish_loop)
    else Core.StopModule("Fishing") end
    Core.Log("Fishing", "INFO", on and "BẬT" or "TẮT")
end

function Fishing.GetState()
    return { Enabled = Fish_State.Enabled, Casts = Fish_State.Casts, Catches = Fish_State.Catches }
end

