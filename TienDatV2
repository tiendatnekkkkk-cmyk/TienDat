function API.IsBossName(name)
    local n = name:lower():gsub("_", " ")
    for _, b in ipairs(Patterns.Boss) do
        local bl = b:lower():gsub("_", " ")
        if n:find(bl, 1, true) then return true, b end
    end
    return false
end

function API.IsChestModel(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("Model") then return false end
    local n = obj.Name:lower()
    if not n:find("chest") and not n:find("crate") and not n:find("box") then
        return false
    end
    local pp = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not pp then return false end
    return true
end

function API.ScanFruits(maxRange)
    local fruits = {}
    local lp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, obj in ipairs(workspace:GetChildren()) do
        local isF, pname = API.IsFruitName(obj.Name)
        if isF then
            local handle = obj:FindFirstChild("Handle")
                         or (obj:IsA("BasePart") and obj)
                         or obj.PrimaryPart
            if handle then
                if not maxRange or not lp
                   or (handle.Position - lp.Position).Magnitude <= maxRange then
                    table.insert(fruits, { obj = obj, handle = handle, name = pname })
                end
            end
        end
    end
    return fruits
end

function API.ScanChests(maxRange)
    local chests = {}
    local lp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, obj in ipairs(workspace:GetDescendants()) do
        if API.IsChestModel(obj) then
            local pr = obj.PrimaryPart
                    or obj:FindFirstChild("HumanoidRootPart")
                    or obj:FindFirstChildWhichIsA("BasePart")
            if pr then
                if not maxRange or not lp
                   or (pr.Position - lp.Position).Magnitude <= maxRange then
                    table.insert(chests, { obj = obj, part = pr })
                end
            end
        end
    end
    return chests
end

function API.ScanBosses(maxRange)
    local bosses = {}
    local lp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local env = workspace:FindFirstChild("Enemies")
    local containers = { env, workspace }
    for _, c in ipairs(containers) do
