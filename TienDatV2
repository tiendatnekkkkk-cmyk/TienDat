local Boss_State = { Enabled = false, ActiveBoss = nil, SpawnPos = nil, KillCount = 0, CacheTarget = nil, CacheAt = 0 }

local BossSpawns = {
    ["Rip Indra"]    = Vector3.new(62440, 16, 2380),
    ["Cake Prince"]  = Vector3.new(63820, 120, 4310),
    ["Longma"]       = Vector3.new(66720, 350, 1480),
    ["Golem"]        = Vector3.new(62310, 905, -1190),
    ["Draco"]        = Vector3.new(62340, 910, -1210),
    ["Elite Hunter"] = Vector3.new(59430, 16, 1830),
    ["Soul Reaper"]  = Vector3.new(60050, 16, 1740),
    ["Greybeard"]    = Vector3.new(59310, 16, 5550),
    ["Katakuri"]     = Vector3.new(63820, 120, 4310),
}

local function Boss_getChar()
    local c = LP.Character
    if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if r and h and h.Health > 0 then return c, r, h end
end

local function Boss_findBoss(name)
    local n = name:lower()
    for _, m in ipairs(workspace:GetChildren()) do
        if m:IsA("Model") and m.Name:lower():find(n) then
            local h = m:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then return m end
        end
    end
end

local function Boss_loop()
    while Boss_State.Enabled and Core.State.Status == "RUNNING" do
        pcall(function()
            local char, root, hum = Boss_getChar()
            if not root then task.wait(1); return end
            local boss = Boss_findBoss(Boss_State.ActiveBoss)
            if not boss then
                if Boss_State.SpawnPos then
                    local dist = (root.Position - Boss_State.SpawnPos).Magnitude
                    if dist > Boss_Config.TPRange then
                        pcall(function()
                            root.CFrame = CFrame.new(Boss_State.SpawnPos + Vector3.new(0, 4, 0))
                        end)
                    end
                end
                task.wait(Boss_Config.SpawnCheck)
                return
            end
            local tr = boss:FindFirstChild("HumanoidRootPart") or boss.PrimaryPart
            if not tr then task.wait(0.5); return end
            local dist = (root.Position - tr.Position).Magnitude
            if dist > Boss_Config.TPRange then
                pcall(function()
                    root.CFrame = CFrame.new(tr.Position + Vector3.new(0, 5, 0))
                end)
            else
                pcall(function()
                    root.CFrame = CFrame.lookAt(tr.Position + Vector3.new(0, 5, 0), tr.Position)
                end)
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
            local bh = boss:FindFirstChildOfClass("Humanoid")
            if bh and bh.Health <= 0 then
                Boss_State.KillCount = Boss_State.KillCount + 1
                Core.Emit("Boss:Kill", { name = Boss_State.ActiveBoss })
                Boss_State.CacheTarget = nil
            end
        end)
        task.wait(0.15)
    end
end

function Boss.Toggle(bossName, on)
    if not BossSpawns[bossName] then
        Core.Log("Boss", "WARN", "unknown boss: "..tostring(bossName))
        return
    end
    if on then
        Boss_State.ActiveBoss = bossName
        Boss_State.SpawnPos = BossSpawns[bossName]
        Boss_State.Enabled = true
        Core.StartModule("Boss", Boss_loop)
        Core.Log("Boss", "INFO", "BẬT: "..bossName)
    else
        Boss_State.Enabled = false
        Boss_State.ActiveBoss = nil
        Core.StopModule("Boss")
        Core.Log("Boss", "INFO", "TẮT")
    end
end

function Boss.GetState()
    return { Enabled = Boss_State.Enabled, ActiveBoss = Boss_State.ActiveBoss, KillCount = Boss_State.KillCount }
end

