--  MODULE 11 — UIToggle
-- ══════════════════════════════════════════════════════════════════════════
local UIToggle = {}
local UIT_Config = {
    ButtonSize = 50,
    ButtonPos = UDim2.new(0.9, 0, 0.1, 0),
    TweenTime = 0.2,
    Hotkey = Enum.KeyCode.RightShift,
    Colors = {
        OpenBg = Color3.fromRGB(80, 100, 255),
        ClosedBg = Color3.fromRGB(40, 40, 55),
        OpenStroke = Color3.fromRGB(120, 140, 255),
        ClosedStroke = Color3.fromRGB(90, 90, 110),
    },
    Text = { Open = "O", Closed = "—" },
}
local UIT_State = { Gui = nil, Btn = nil, Stroke = nil, Window = nil, Open = true, HotkeyConn = nil, ClickConn = nil, ToggleCount = 0 }

local function UIT_resolveParent()
    local p
    pcall(function() p = game:GetService("CoreGui") end)
    if p then return p end
    return LP:WaitForChild("PlayerGui")
end

local function UIT_applyVisual(open)
    if not UIT_State.Btn or not UIT_State.Stroke then return end
    local c = UIT_Config.Colors
    Services.TweenService:Create(UIT_State.Btn, TweenInfo.new(UIT_Config.TweenTime), {
        BackgroundColor3 = open and c.OpenBg or c.ClosedBg,
    }):Play()
    Services.TweenService:Create(UIT_State.Stroke, TweenInfo.new(UIT_Config.TweenTime), {
        Color = open and c.OpenStroke or c.ClosedStroke,
    }):Play()
    UIT_State.Btn.Text = open and UIT_Config.Text.Open or UIT_Config.Text.Closed
end

local function UIT_toggle(forceState)
    local target = forceState
    if target == nil then target = not UIT_State.Open end
    if target == UIT_State.Open then return end
    UIT_State.Open = target
    UIT_State.ToggleCount = UIT_State.ToggleCount + 1
    if UIT_State.Window then
        pcall(function()
            if target then UIT_State.Window:Open() else UIT_State.Window:Close() end
        end)
        UIT_applyVisual(target)
        Core.Log("UIToggle", "INFO", target and "UI mở" or "UI đóng")
        Core.Emit(target and "UIToggle:Open" or "UIToggle:Close")
    end
end

local function UIT_destroy()
    if UIT_State.HotkeyConn then pcall(function() UIT_State.HotkeyConn:Disconnect() end); UIT_State.HotkeyConn = nil end
    if UIT_State.ClickConn then pcall(function() UIT_State.ClickConn:Disconnect() end); UIT_State.ClickConn = nil end
    if UIT_State.Gui then pcall(function() UIT_State.Gui:Destroy() end); UIT_State.Gui = nil end
    UIT_State.Btn = nil
    UIT_State.Stroke = nil
end

local function UIT_build(windowRef)
    if UIT_State.Gui and UIT_State.Gui.Parent then return true end
    UIT_State.Window = windowRef
    local parent = UIT_resolveParent()
    local existing = parent:FindFirstChild("ZT_Toggle")
    if existing then pcall(function() existing:Destroy() end) end

    local gui = Instance.new("ScreenGui")
    gui.Name = "ZT_Toggle"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 1000
    gui.IgnoreGuiInset = true
    gui.Parent = parent

    local btn = Instance.new("TextButton", gui)
    btn.Size = UDim2.fromOffset(UIT_Config.ButtonSize, UIT_Config.ButtonSize)
    btn.Position = UIT_Config.ButtonPos
    btn.BackgroundColor3 = UIT_Config.Colors.OpenBg
    btn.Text = UIT_Config.Text.Open
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.TextSize = 26
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Active = true
    btn.Draggable = true
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = UIT_Config.Colors.OpenStroke
    stroke.Thickness = 2

    UIT_State.Gui = gui
    UIT_State.Btn = btn
    UIT_State.Stroke = stroke

    UIT_State.ClickConn = btn.MouseButton1Click:Connect(function()
        UIT_toggle(nil)
    end)

    UIT_State.HotkeyConn = Services.UserInputService.InputBegan:Connect(function(input, gp)
        if input.KeyCode ~= UIT_Config.Hotkey then return end
        if gp then return end
        if Services.UserInputService:GetFocusedTextBox() then return end
        UIT_toggle(nil)
    end)
    return true
end

function UIToggle.Build(windowRef) return UIT_build(windowRef) end
function UIToggle.Toggle(forceState) UIT_toggle(forceState) end
function UIToggle.Open() UIT_toggle(true) end
function UIToggle.Close() UIT_toggle(false) end
function UIToggle.GetState()
    return { Open = UIT_State.Open, ToggleCount = UIT_State.ToggleCount }
end

Core.On("Core:Unload", function() UIT_destroy() end)

