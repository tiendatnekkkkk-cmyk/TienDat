--  CORE — Supervisor, EventBus, Logger, Cache
-- ══════════════════════════════════════════════════════════════════════════
local Core = {}

Core.VERSION = "4.2.0"
Core.GAME    = "Blox Fruits"

Core.State = {
    Status  = "LOADING",
    Modules = {},
    Config  = {
        PlayerName       = Services.LP.Name,
        WebhookURL       = "",
        MaxRestarts      = 5,
        RestartWindow    = 60,
        HealthCheckEvery = 15,
        LogLevel         = 3,
    },
    Cache    = {},
    EventBus = {},
}

local RANK = { DEBUG = 4, INFO = 3, WARN = 2, ERROR = 1 }

function Core.Log(module, level, msg)
    module = module or "CORE"
    level  = level  or "INFO"
    if (RANK[level] or 0) > (Core.State.Config.LogLevel or 3) then return end
    local line = string.format("[ZT][%s][%s] %s", module, level, tostring(msg))
    print(line)
    if level == "ERROR" and Core.State.Config.WebhookURL ~= "" then
        task.spawn(function()
            pcall(function()
                local H = game:GetService("HttpService")
                request({
                    Url = Core.State.Config.WebhookURL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = H:JSONEncode({
                        username = "ZeroTiger v4.2",
                        content = string.format("**%s** `%s` %s",
                            Core.State.Config.PlayerName, module, tostring(msg))
                    })
                })
            end)
        end)
    end
end

function Core.On(name, fn)
    Core.State.EventBus[name] = Core.State.EventBus[name] or {}
    table.insert(Core.State.EventBus[name], fn)
    return fn
end

function Core.Emit(name, data)
    local hs = Core.State.EventBus[name]
    if not hs then return end
    for _, fn in ipairs(hs) do
        pcall(fn, data)
    end
end

function Core.StartModule(name, fn)
    local old = Core.State.Modules[name]
    if old and old.thread then pcall(task.cancel, old.thread) end
    local mod = {
        fn = fn, restartCount = 0, firstRestart = tick(),
        status = "RUNNING", lastError = nil,
    }
    Core.State.Modules[name] = mod
    mod.thread = task.spawn(function()
        while Core.State.Status ~= "UNLOADED" do
            local ok, err = pcall(fn)
            if ok then break end
            mod.lastError = tostring(err)
            Core.Log(name, "ERROR", "crash: "..mod.lastError)
            if tick() - mod.firstRestart > Core.State.Config.RestartWindow then
                mod.restartCount = 0
                mod.firstRestart = tick()
            end
            mod.restartCount = mod.restartCount + 1
            if mod.restartCount > Core.State.Config.MaxRestarts then
                Core.Log(name, "ERROR", "restart limit — DISABLED")
                mod.status = "DISABLED"
                break
            end
            task.wait(2)
        end
    end)
end

function Core.StopModule(name)
    local mod = Core.State.Modules[name]
    if not mod then return end
    if mod.thread then pcall(task.cancel, mod.thread); mod.thread = nil end
    mod.status = "STOPPED"
end

function Core.Cached(key, ttl, fetchFn)
    local e = Core.State.Cache[key]
    if e and tick() - e.time < ttl then return e.value end
    local ok, v = pcall(fetchFn)
    if ok then
        Core.State.Cache[key] = { value = v, time = tick() }
        return v
    end
    return e and e.value or nil
end

function Core.StartHealthCheck()
    task.spawn(function()
        while Core.State.Status ~= "UNLOADED" do
            task.wait(Core.State.Config.HealthCheckEvery)
            for name, mod in pairs(Core.State.Modules) do
                if mod.status == "RUNNING" and mod.thread
                   and coroutine.status(mod.thread) == "dead" then
                    Core.Log(name, "WARN", "health: restart dead thread")
                    Core.StartModule(name, mod.fn)
                end
            end
        end
    end)
end

function Core.Shutdown()
    Core.Log("CORE", "INFO", "shutdown")
    Core.Emit("Core:Unload")
    for _, mod in pairs(Core.State.Modules) do
        if mod.thread then pcall(task.cancel, mod.thread) end
    end
    Core.State.Status = "UNLOADED"
end

Core.State.Status = "RUNNING"
Core.StartHealthCheck()
getgenv().ZeroTiger_Unload = Core.Shutdown

