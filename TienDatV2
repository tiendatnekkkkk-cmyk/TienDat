--  MODULE 8 — Hop
-- ══════════════════════════════════════════════════════════════════════════
local Hop = {}
local Hop_Config = { MaxPages = 3, PageSize = 100, AutoHopInterval = 3, ReconnectDelay = 1.5 }
local Hop_State = { AutoHop = false, Reconnect = true, HopCount = 0, KickDetected = 0, KickHook = nil }

local function Hop_safeRejoin()
    return pcall(function()
        Services.TeleportService:Teleport(game.PlaceId, LP)
    end)
end

local function Hop_installKickHook()
    pcall(function()
        local oldNC
        oldNC = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if not checkcaller() and method == "Kick" then
                Hop_State.KickDetected = Hop_State.KickDetected + 1
                Core.Log("Hop", "WARN", "kick intercepted ("..Hop_State.KickDetected..")")
                if Hop_State.Reconnect then
                    task.spawn(function()
                        task.wait(Hop_Config.ReconnectDelay)
                        if not Hop_safeRejoin() then
                            Core.Log("Hop", "ERROR", "rejoin failed")
                            Hop.Hop()
                        end
                    end)
                end
                return
            end
            return oldNC(self, ...)
        end)
        Hop_State.KickHook = oldNC
    end)
end
Hop_installKickHook()

local function Hop_serverHop()
    local cursor = ""
    local page = 0
    while page < Hop_Config.MaxPages do
        page = page + 1
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=%d",
            game.PlaceId, Hop_Config.PageSize
        )
        if cursor ~= "" then url = url.."&cursor="..cursor end
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if not ok or not res then
            Core.Log("Hop", "ERROR", "HTTP failed")
            return false
        end
        local ok2, data = pcall(function() return Services.HttpService:JSONDecode(res) end)
        if not ok2 or not data or not data.data then
            Core.Log("Hop", "ERROR", "decode failed")
            return false
        end
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < (s.maxPlayers - 1) then
                Hop_State.HopCount = Hop_State.HopCount + 1
                Core.Log("Hop", "INFO", "hopping to "..s.id)
                pcall(function()
                    Services.TeleportService:TeleportToPlaceInstance(
                        game.PlaceId, s.id, LP
                    )
                end)
                return true
            end
        end
        cursor = data.nextPageCursor or ""
        if cursor == "" then break end
    end
    Core.Log("Hop", "WARN", "no usable server")
    return false
end

function Hop.Hop() return Hop_serverHop() end

function Hop.Rejoin()
    Core.Log("Hop", "INFO", "rejoin requested")
    return Hop_safeRejoin()
end

function Hop.ToggleAutoHop(on)
    if on == Hop_State.AutoHop then return end
    Hop_State.AutoHop = on
    if on then
        Core.StartModule("AutoHop", function()
            while Hop_State.AutoHop and Core.State.Status ~= "UNLOADED" do
                pcall(function()
                    local char = LP.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        for _, p in ipairs(Services.Players:GetPlayers()) do
                            if p ~= LP and p.Character then
                                local pr = p.Character:FindFirstChild("HumanoidRootPart")
                                if pr and (pr.Position - root.Position).Magnitude < 25 then
                                    Core.Log("Hop", "INFO", "player nearby, hopping")
                                    Hop_serverHop()
                                    return
                                end
                            end
                        end
                    end
                end)
                task.wait(Hop_Config.AutoHopInterval)
            end
        end)
    else
        Core.StopModule("AutoHop")
    end
    Core.Log("Hop", "INFO", "AutoHop "..(on and "BẬT" or "TẮT"))
end

function Hop.SetReconnect(on)
    Hop_State.Reconnect = on
    Core.Log("Hop", "INFO", "Reconnect "..(on and "BẬT" or "TẮT"))
end

function Hop.GetState()
    return { AutoHop = Hop_State.AutoHop, Reconnect = Hop_State.Reconnect, HopCount = Hop_State.HopCount, KickDetected = Hop_State.KickDetected }
end

