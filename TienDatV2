-- ── Remote resolver ──────────────────────────────────────────────────────
local function ResolveRemotes()
    local resolved = { CommF = nil, CommE = nil, paths = {} }

    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        resolved.CommF = remotes:FindFirstChild("CommF_")
        resolved.CommE = remotes:FindFirstChild("CommE")
        if resolved.CommF then table.insert(resolved.paths, "Remotes/CommF_") end
        if resolved.CommE then table.insert(resolved.paths, "Remotes/CommE") end
    end

    if not resolved.CommF then
        resolved.CommF = RS:FindFirstChild("CommF_")
        if resolved.CommF then table.insert(resolved.paths, "RS/CommF_") end
    end
    if not resolved.CommE then
        resolved.CommE = RS:FindFirstChild("CommE")
        if resolved.CommE then table.insert(resolved.paths, "RS/CommE") end
    end

    if not resolved.CommF then
        resolved.CommF = RS:FindFirstChild("CommF_", true)
        if resolved.CommF then table.insert(resolved.paths, "recursive/CommF_") end
    end
    if not resolved.CommE then
        resolved.CommE = RS:FindFirstChild("CommE", true)
        if resolved.CommE then table.insert(resolved.paths, "recursive/CommE") end
    end

    if not resolved.CommF then
        for _, alt in ipairs({ "CommF", "CommunicationF", "RemoteF_" }) do
            local r = RS:FindFirstChild(alt, true)
            if r and r:IsA("RemoteFunction") then
                resolved.CommF = r
                table.insert(resolved.paths, "alt/"..alt)
                break
            end
        end
    end

    if resolved.CommF then
        API_State.CommF = resolved.CommF
        Core.Log("API", "INFO", "CommF_ resolved via: "..table.concat(resolved.paths, ", "))
    else
        Core.Log("API", "ERROR", "CommF_ NOT FOUND — auto-buy/stat sẽ không hoạt động")
    end
    if resolved.CommE then
        API_State.CommE = resolved.CommE
    end

    API_State.LastResolve = tick()
    return resolved.CommF ~= nil
end

-- ── Combat hook ──────────────────────────────────────────────────────────
local function HookCombat()
    pcall(function()
        require(RS.Util.CameraShaker):Stop()
    end)
    local ok, reg = pcall(getreg)
    if not ok then return false end
    local ps = LP:FindFirstChild("PlayerScripts")
    local cf = ps and ps:FindFirstChild("CombatFramework")
    if not cf then return false end

    for _, v in ipairs(reg) do
        if typeof(v) == "function" then
            local ok2, env = pcall(getfenv, v)
            if ok2 and env and env.script == cf then
                local ok3, ups = pcall(debug.getupvalues, v)
                if ok3 and ups then
                    for _, uv in ipairs(ups) do
                        if typeof(uv) == "table" and uv.activeController then
                            API_State.CombatActive = uv
                            API_State.Hooked = true
                            Core.Log("API", "INFO", "combat hook OK")
                            return true
                        end
                    end
                end
            end
        end
    end
    Core.Log("API", "WARN", "combat hook failed — fallback mode")
    return false
end

-- ── Safe invoke ──────────────────────────────────────────────────────────
local function SafeInvoke(remote, ...)
    if not remote then return false end
    local ok1 = pcall(function() remote:InvokeServer(...) end)
    if ok1 then return true end
    local ok2 = pcall(function() remote:FireServer(...) end)
    if ok2 then return true end
    Core.Log("API", "WARN", "invoke failed on "..remote.Name)
    return false
end

local function EnsureRemote()
    if API_State.CommF and API_State.CommF.Parent then return true end
    if tick() - API_State.LastResolve < 5 then return API_State.CommF ~= nil end
    return ResolveRemotes()
end

local function EnsureHook()
    if API_State.Hooked and API_State.CombatActive then return true end
    return HookCombat()
end

