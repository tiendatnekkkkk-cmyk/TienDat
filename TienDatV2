--  MODULE 2 — Farm
-- ══════════════════════════════════════════════════════════════════════════
local Farm = {}
local Farm_Config = { Range = 300, AttackInterval = 0.05, CacheTTL = 0.4, DeadDelay = 1.2 }
local Farm_State = { Enabled = false, Target = nil, CacheAt = 0, KillCount = 0 }

local function Farm_getChar()
    local c = LP.Character
    if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if r and h and h.Health > 0 then return c, r, h end
end

local function Farm_findTarget(root)
    local best, bd = nil, Farm_Config.Range
    local containers = { workspace:FindFirstChild("Enemies"), workspace }
    for _, c in ipairs(containers) do
        if c then
            for _, m in ipairs(c:GetChildren()) do
                if m:IsA("Model") and m ~= LP.Character then
                    local h = m:FindFirstChildOfClass("Humanoid")
                    local r = m:FindFirstChild("HumanoidRootPart")
                    if h and h.Health > 0 and r then
                        local d = (r.Position - root.Position).Magnitude
                        if d < bd then best, bd = m, d end
                    end
                end
            end
        end
    end
    return best
end

local function Farm_attack(char, target)
    local th = target and target:FindFirstChild("HumanoidRootPart")
    if API.HumanizedAttack then
        API.HumanizedAttack()
    else
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
end

local function Farm_loop()
    while Farm_State.Enabled and Core.State.Status == "RUNNING" do
        pcall(function()
            local char, root, hum = Farm_getChar()
            if not char then task.wait(1); return end
            if hum.PlatformStand then hum.PlatformStand = false end

            local now = tick()
            if not Farm_State.Target or not Farm_State.Target.Parent
               or (now - Farm_State.CacheAt) > Farm_Config.CacheTTL then
                Farm_State.Target = Farm_findTarget(root)
                Farm_State.CacheAt = now
            end

            local target = Farm_State.Target
            if target then
                local tr = target:FindFirstChild("HumanoidRootPart")
                if tr then
                    tr.CFrame = CFrame.new(root.Position + root.CFrame.LookVector * 4)
                    tr.AssemblyLinearVelocity = Vector3.zero
                end
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bp = LP:FindFirstChild("Backpack")
                    if bp and hum then
                        for _, t in ipairs(bp:GetChildren()) do
                            if t:IsA("Tool") then
                                pcall(function() hum:EquipTool(t) end)
                                break
                            end
                        end
                    end
                end
                Farm_attack(char, target)
                local th = target:FindFirstChildOfClass("Humanoid")
                if th and th.Health <= 0 then
                    Farm_State.KillCount = Farm_State.KillCount + 1
                    Core.Emit("Farm:Kill", { target = target.Name })
                    Farm_State.Target = nil
                    task.wait(Farm_Config.DeadDelay)
                end
            end
        end)
        task.wait(Farm_Config.AttackInterval)
    end
end

function Farm.Toggle(on)
    if on == Farm_State.Enabled then return end
    Farm_State.Enabled = on
    if on then
        API.EnsureCombatHook()
        Core.StartModule("Farm", Farm_loop)
        Core.Log("Farm", "INFO", "BẬT")
    else
