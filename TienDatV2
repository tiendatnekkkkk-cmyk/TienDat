--  MODULE 3 — ESP
-- ══════════════════════════════════════════════════════════════════════════
local ESP = {}
local ESP_Config = { UpdateInterval = 0.1, MaxDistance = 5000 }
local ESP_State = { Enabled = false, Filters = { Player = false, Boss = false, Fruit = false, Chest = false }, Pool = {} }
local DrawingNew = Drawing and Drawing.new or (getgenv().Drawing and getgenv().Drawing.new)

local function ESP_isAlive(obj)
    if not obj or not obj.Parent then return false end
    local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
    if not hrp then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    return true, hrp
end

local function ESP_release(obj)
    local e = ESP_State.Pool[obj]
    if not e then return end
    pcall(function() if e.box then e.box:Remove() end end)
    pcall(function() if e.name then e.name:Remove() end end)
    ESP_State.Pool[obj] = nil
end

local function ESP_clear()
    for obj in pairs(ESP_State.Pool) do ESP_release(obj) end
    ESP_State.Pool = {}
end

local function ESP_acquire(obj, kind)
    local e = ESP_State.Pool[obj]
    if e then return e end
    local color = Color3.fromRGB(255, 80, 80)
    if kind == "Boss" then color = Color3.fromRGB(255, 255, 0)
    elseif kind == "Fruit" then color = Color3.fromRGB(0, 255, 120)
    elseif kind == "Chest" then color = Color3.fromRGB(150, 100, 255) end
    e = { box = DrawingNew("Square"), name = DrawingNew("Text") }
    e.box.Visible = false
    e.box.Color = color
    e.box.Thickness = 1
    e.name.Visible = false
    e.name.Color = color
    e.name.Size = 14
    e.name.Center = true
    e.name.Outline = true
    ESP_State.Pool[obj] = e
    return e
end

local function ESP_renderOne(cam, obj, kind)
    local alive, hrp = ESP_isAlive(obj)
    if not alive then ESP_release(obj); return end
    local e = ESP_acquire(obj, kind)
    local dist = (cam.CFrame.Position - hrp.Position).Magnitude
    if dist > ESP_Config.MaxDistance then
        e.box.Visible = false; e.name.Visible = false; return
    end
    local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
    if not onScreen then
        e.box.Visible = false; e.name.Visible = false; return
    end
    local size = 1000 / math.max(dist, 1)
    e.box.Size = Vector2.new(size, size * 1.5)
    e.box.Position = Vector2.new(pos.X - size/2, pos.Y - size*0.75)
    e.box.Visible = true
    e.name.Text = string.format("%s [%dm]", obj.Name, math.floor(dist))
    e.name.Position = Vector2.new(pos.X, pos.Y - size*0.9)
    e.name.Visible = true
end

local function ESP_loop()
    while ESP_State.Enabled and Core.State.Status ~= "UNLOADED" do
        pcall(function()
            local cam = workspace.CurrentCamera
            if not cam then return end
            local candidates = {}
            if ESP_State.Filters.Player then
                for _, p in ipairs(Services.Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        table.insert(candidates, { obj = p.Character, kind = "Player" })
                    end
                end
            end
            if ESP_State.Filters.Boss then
                for _, m in ipairs(workspace:GetChildren()) do
                    if m:IsA("Model") and API.IsBossName(m.Name) then
                        table.insert(candidates, { obj = m, kind = "Boss" })
                    end
                end
            end
            if ESP_State.Filters.Fruit then
                for _, f in ipairs(API.ScanFruits()) do
                    table.insert(candidates, { obj = f.obj, kind = "Fruit" })
                end
            end
            if ESP_State.Filters.Chest then
                for _, c in ipairs(API.ScanChests()) do
                    table.insert(candidates, { obj = c.obj, kind = "Chest" })
                end
            end
            for _, c in ipairs(candidates) do
                ESP_renderOne(cam, c.obj, c.kind)
            end
        end)
        task.wait(ESP_Config.UpdateInterval)
    end
end

function ESP.Toggle(on)
    if on == ESP_State.Enabled then return end
    if on and not DrawingNew then
        Core.Log("ESP", "ERROR", "Drawing API unavailable")
        return
    end
    ESP_State.Enabled = on
    if on then
        Core.StartModule("ESP", ESP_loop)
        Core.Log("ESP", "INFO", "BẬT")
    else
        Core.StopModule("ESP")
        ESP_clear()
        Core.Log("ESP", "INFO", "TẮT")
    end
end

function ESP.SetFilter(kind, on)
    if ESP_State.Filters[kind] ~= nil then ESP_State.Filters[kind] = on end
end

function ESP.GetState()
    local count = 0
    for _ in pairs(ESP_State.Pool) do count = count + 1 end
    return { Enabled = ESP_State.Enabled, Filters = ESP_State.Filters, BoxCount = count }
end

