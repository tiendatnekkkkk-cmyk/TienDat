local AutoQuest = {}
local Quest_Config = { TPInterval = 0.5, QuestRange = 15, CheckInterval = 2.0 }
local QuestDB = {
    BanditQuest1   = { npc = Vector3.new(1059, 16, 1545),  mob = Vector3.new(1090, 16, 1560) },
    JungleQuest    = { npc = Vector3.new(-1745, 30, -296),  mob = Vector3.new(-1600, 30, -300) },
