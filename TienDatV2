--  MODULE 16 — FruitNotifier
-- ══════════════════════════════════════════════════════════════════════════
local FruitNotifier = {}
local Notify_Config = { ScanInterval = 2.0, WebhookURL = "" }
local Notify_State = { Enabled = false, Seen = {}, FruitCount = 0 }

local function Notify_getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Notify_sendWebhook(content)
    if Notify_Config.WebhookURL == "" or not request then return end
    pcall(request, {
        Url = Notify_Config.WebhookURL,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = Services.HttpService:JSONEncode({
            username = "ZeroTiger Fruit Radar",
            content = content,
        }),
    })
end

local function Notify_loop()
    while Notify_State.Enabled and Core.State.Status == "RUNNING" do
        pcall(function()
            local root = Notify_getRoot()
            if not root then return end
            local fruits = API.ScanFruits(99999)
            for _, f in ipairs(fruits) do
                if not Notify_State.Seen[f.obj] then
                    Notify_State.Seen[f.obj] = true
                    Notify_State.FruitCount = Notify_State.FruitCount + 1
                    local dist = (f.handle.Position - root.Position).Magnitude
                    local coordStr = string.format("(%.0f, %.0f, %.0f)",
                        f.handle.Position.X, f.handle.Position.Y, f.handle.Position.Z)
                    Core.Log("FruitNotifier", "INFO",
                        string.format("FRUIT: %s @ %s [%.0fm]", f.name, coordStr, dist))
                    Notify_sendWebhook(string.format(
                        "🍎 **Fruit Spawn**: `%s`\n📍 `%s`\n📏 %.0fm",
                        f.name, coordStr, dist))
                    pcall(function()
                        local pg = LP:FindFirstChild("PlayerGui")
                        local main = pg and pg:FindFirstChild("Main")
                        local radar = main and main:FindFirstChild("Radar")
                        if radar then
                            radar.Text = string.format("%s (%dm)", f.name, math.floor(dist))
                            radar.Visible = true
                        end
                    end)
                    Core.Emit("FruitNotifier:Detected", {
                        name = f.name, pos = f.handle.Position, dist = dist,
                    })
                end
            end
        end)
        task.wait(Notify_Config.ScanInterval)
    end
end

function FruitNotifier.Toggle(on)
    if on == Notify_State.Enabled then return end
    Notify_State.Enabled = on
    if on then Core.StartModule("FruitNotifier", Notify_loop)
    else Core.StopModule("FruitNotifier") end
    Core.Log("FruitNotifier", "INFO", on and "BẬT" or "TẮT")
end

function FruitNotifier.SetWebhook(url) Notify_Config.WebhookURL = url or "" end
function FruitNotifier.GetState()
    return { Enabled = Notify_State.Enabled, Detected = Notify_State.FruitCount }
end

