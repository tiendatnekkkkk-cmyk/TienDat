--  MODULE 10 — AutoPickup
-- ══════════════════════════════════════════════════════════════════════════
local AutoPickup = {}
local Pickup_Config = { Range = 600, ScanTTL = 0.8, TweenMax = 1.5, PickupWait = 0.3, Categories = { Chest = true, Fruit = true, Drop = true } }
local Pickup_State = { Enabled = false, Seen = {}, CacheAt = 0, List = {}, Count = { Chest = 0, Fruit = 0, Drop = 0 } }

local function Pickup_getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Pickup_scanAll()
    local now = tick()
    if now - Pickup_State.CacheAt < Pickup_Config.ScanTTL then return Pickup_State.List end
    local list = {}
    if Pickup_Config.Categories.Chest then
        for _, c in ipairs(API.ScanChests(Pickup_Config.Range)) do
            c.kind = "Chest"
            table.insert(list, c)
        end
    end
    if Pickup_Config.Categories.Fruit then
        for _, f in ipairs(API.ScanFruits(Pickup_Config.Range)) do
            f.part = f.handle
            f.kind = "Fruit"
            table.insert(list, f)
        end
    end
    if Pickup_Config.Categories.Drop then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                table.insert(list, { obj = obj, part = obj.Handle, kind = "Drop", name = obj.Name })
            end
        end
    end
    Pickup_State.CacheAt = now
    Pickup_State.List = list
    return list
end

local function Pickup_pickup(root, entry)
    local part = entry.part or entry.handle
    if not part then return end
    local dist = (part.Position - root.Position).Magnitude
    if dist < 3 then return end
    local dur = math.clamp(dist / 1500, 0.1, Pickup_Config.TweenMax)
    local tw = Services.TweenService:Create(
        root, TweenInfo.new(dur, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0)) }
    )
    tw:Play()
    tw.Completed:Wait()
    local pp = entry.obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp and fireproximityprompt then
        pcall(fireproximityprompt, pp)
    elseif entry.obj:IsA("Tool") then
        pcall(function() entry.obj:Activate() end)
    end
    task.wait(Pickup_Config.PickupWait)
end

local function Pickup_loop()
    while Pickup_State.Enabled and Core.State.Status == "RUNNING" do
        pcall(function()
            local root = Pickup_getRoot()
            if not root then task.wait(1); return end
            for _, entry in ipairs(Pickup_scanAll()) do
                if not Pickup_State.Enabled then break end
                if not Pickup_State.Seen[entry.obj] then
                    Pickup_State.Seen[entry.obj] = true
                    Pickup_pickup(root, entry)
                    Pickup_State.Count[entry.kind] = (Pickup_State.Count[entry.kind] or 0) + 1
                    Core.Log("AutoPickup", "INFO", "picked "..entry.kind..": "..tostring(entry.name))
                    Core.Emit("AutoPickup:Picked", entry)
                end
            end
        end)
        task.wait(Pickup_Config.ScanTTL)
    end
end

function AutoPickup.Toggle(on)
    if on == Pickup_State.Enabled then return end
    Pickup_State.Enabled = on
    if on then Core.StartModule("AutoPickup", Pickup_loop)
    else Core.StopModule("AutoPickup") end
    Core.Log("AutoPickup", "INFO", on and "BẬT" or "TẮT")
end

function AutoPickup.SetCategory(cat, on)
    if Pickup_Config.Categories[cat] ~= nil then Pickup_Config.Categories[cat] = on end
end

function AutoPickup.SetRange(v)
    local n = tonumber(v)
    if n then Pickup_Config.Range = math.clamp(n, 100, 2000) end
end

function AutoPickup.GetState()
    return { Enabled = Pickup_State.Enabled, Count = Pickup_State.Count }
end

